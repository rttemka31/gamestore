DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com
DJANGO_HTTPS=0
DJANGO_HSTS_SECONDS=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Почта для писем «Сброс пароля». Для Gmail: адрес и пароль приложения (Аккаунт Google → Безопасность →
# Пароли приложений). Пусто — письма не отправляются, восстановить вход можно только через Discord/Google
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=